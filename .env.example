# =============================================================
# Contract Guardian AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=Contract Guardian AI
APP_ENV=local

# ── PostgreSQL (CO1 - Relational DB) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://contract_guardian:contract_guardian@localhost:5432/contract_guardian
POSTGRES_USER=contract_guardian
POSTGRES_PASSWORD=contract_guardian
POSTGRES_DB=contract_guardian

# ── MongoDB (CO2 - NoSQL) ─────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=contract_guardian

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI / OpenAI (optional — heuristic fallback if omitted) ───
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Vector / pgvector ─────────────────────────────────────────
VECTOR_INDEX_TYPE=hnsw
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Observability ─────────────────────────────────────────────
PROMETHEUS_ENABLED=true

# ── Frontend ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
