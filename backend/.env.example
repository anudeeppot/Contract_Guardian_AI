APP_NAME=Contract Guardian AI
APP_ENV=local

# Database (CO1: PostgreSQL)
DATABASE_URL=postgresql+asyncpg://contract_guardian:contract_guardian@localhost:5432/contract_guardian
# For local SQLite dev (no PostgreSQL needed):
# DATABASE_URL=sqlite+aiosqlite:///./contract_guardian.db

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# File storage
UPLOAD_DIR=/tmp/contract-guardian/uploads
REPORT_DIR=/tmp/contract-guardian/reports
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt

# OpenAI (optional - heuristic fallback used if not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# OCR (optional)
OCR_ENABLED=false

# MongoDB (CO2: polyglot persistence)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=contract_guardian
MONGODB_ENABLED=true

# Vector Search (CO2)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VECTOR_SEARCH_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Pinecone (CO2 - optional)
PINECONE_API_KEY=
PINECONE_INDEX=contract-guardian
PINECONE_ENVIRONMENT=us-east-1

# Weaviate (CO2 - optional)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# Observability (CO6)
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true

# Rate limiting (CO3)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# X402 payment (optional)
X402_ENABLED=false
X402_RECEIVER_ADDRESS=0xReceiverAddress
X402_NETWORK=base
X402_ASSET=USDC
X402_AMOUNT=2.00
X402_FACILITATOR_URL=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,http://localhost:3001

LOG_LEVEL=INFO
